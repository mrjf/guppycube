{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guppycube",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "TWILIO_SID",
      "TWILIO_CLIENT_SECRET",
      "TWILIO_ACCOUNT_SID",
      "TWILIO_AUTH_TOKEN",
      "TWILIO_FROM_NUMBER"
    ]
  },
  "routes": [
    {
      "pattern": "snagsby.com/guppycube",
      "zone_name": "snagsby.com"
    },
    {
      "pattern": "snagsby.com/guppycube/*",
      "zone_name": "snagsby.com"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/guppycube/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
